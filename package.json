{
  "name": "react-util",
  "version": "1.0.1",
  "description": "Utilities for React, like commonly used hooks.",
  "author": "Joost Lubach",
  "private": false,
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./hooks": {
      "types": "./dist/types/hooks/index.d.ts",
      "import": "./dist/esm/hooks/index.js",
      "default": "./dist/cjs/hooks/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && npm run build:tsc",
    "build:tsc": "npm run build:tsc:esm && npm run build:tsc:cjs",
    "build:tsc:esm": "tsc -p tsconfig.prod.json --module es2022 --outDir dist/esm --declarationDir dist/types",
    "build:tsc:cjs": "tsc -p tsconfig.prod.json --module commonjs --outDir dist/cjs --declaration false --declarationMap false",
    "clean": "rimraf dist",
    "check": "tsc -p . --noEmit",
    "lint": "eslint",
    "test": "NODE_ENV=test DATA_ENV=test jest"
  },
  "peerDependencies": {
    "react": "^19.1",
    "react-dom": "^19.1",
    "mobx": ">=6.15"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "logger": "workspace:^",
    "react-timer": "workspace:^",
    "scroll-into-view": "^1.16.2",
    "uuid": "10.0.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@types/react": "^19.1",
    "@types/scroll-into-view": "^1.16.4",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "copyfiles": "^2.4.1",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.4.0",
    "js-yaml": "^4.1.0",
    "rimraf": "6.0.1",
    "tsc-alias": "^1.8.8",
    "typescript": "^5.9.3",
    "ytil": "workspace:^"
  }
}
